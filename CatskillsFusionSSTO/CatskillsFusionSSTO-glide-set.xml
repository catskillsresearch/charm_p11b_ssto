<?xml version="1.0"?>

<!-- this puts the Shuttle at 36.000 ft 20 miles from the airport, simulating a free-fly test -->

<PropertyList include="CatskillsFusionSSTO-common.xml">
<sim>
  <description>CATSKILLS-SSTO-TA-GRENADIER in a free-fly test</description>
  <long-description>
     
     CATSKILLS-SSTO-TA-GRENADIER is a single-stage-to-orbit test article (Grenadier): Shuttle-derived airframe with CHARM plant and 3-cycle electric engine. This free-fly / approach-energy test places the vehicle at an altitude worth about five minutes of gliding flight.
  
  </long-description>
  <variant-of>CatskillsFusionSSTO</variant-of>
  <presets>
	<altitude-ft>10000.0</altitude-ft>
	<pitch-deg>-10.0</pitch-deg>
	<airspeed-kt>200</airspeed-kt>	
	<stage type="int">5</stage>
  </presets>
  <startup>
    <splash-texture>Aircraft/CatskillsFusionSSTO/CatskillsFusionSSTO-grenadier-splash.png</splash-texture>
  </startup>
   <previews>
      <preview>
        <type>exterior</type>
        <splash type="bool">true</splash>
        <path>Pics/grenadier-splash-01.png</path>
      </preview>
      <preview>
        <type>exterior</type>
        <splash type="bool">true</splash>
        <path>Pics/grenadier-splash-02.png</path>
      </preview>
      <preview>
        <type>exterior</type>
        <splash type="bool">true</splash>
        <path>Pics/grenadier-splash-03.png</path>
      </preview>
  </previews>
  <config>
    <shuttle>
      <prelaunch-flag type="int">0</prelaunch-flag>
    </shuttle>
  </config>
  <menubar>
    <default>
     <menu n="51">
      <label>Carrier Aircraft</label>

      <item>
       <label>Controls</label>
       <binding>
        <command>nasal</command>
        <script>SpaceShuttle.carrier_dlg.open()</script>
       </binding>
      </item>
    </menu>
    </default>
  </menubar>
</sim>


<fdm>
   <jsbsim>
	<systems>
	   <dps>
		<ops type="int">3</ops>
		<major-mode type="int">305</major-mode>
		<ops-bfs type="int">3</ops-bfs>
		<major-mode-bfs type="int">305</major-mode-bfs>
	   </dps>
	</systems>
   </jsbsim>
</fdm>


</PropertyList>
