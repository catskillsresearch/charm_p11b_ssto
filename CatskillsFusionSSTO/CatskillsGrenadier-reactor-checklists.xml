<?xml version="1.0"?>
<!-- CATSKILLS-SSTO-TA-GRENADIER — CHARM reactor startup (Help → Checklist) -->
<PropertyList>
  <checklist>
    <title>Grenadier — CHARM startup</title>

    <item>
      <name>Aircraft ID</name>
      <value>CATSKILLS-SSTO-TA-GRENADIER</value>
      <condition>
        <equals>
          <property>/sim/model/grenadier/aircraft-id</property>
          <value>CATSKILLS-SSTO-TA-GRENADIER</value>
        </equals>
      </condition>
    </item>

    <item>
      <name>√ Water tank quantity</name>
      <value>NOTED</value>
    </item>

    <item>
      <name>√ p-11B / proton fuel inventory</name>
      <value>NOTED</value>
    </item>

    <item>
      <name>√ Flight battery ≥ min reserve</name>
      <condition>
        <greater-than-equals>
          <property>/fdm/jsbsim/systems/grenadier/charm/battery-kwh</property>
          <property>/fdm/jsbsim/systems/grenadier/charm/battery-min-kwh</property>
        </greater-than-equals>
      </condition>
    </item>

    <item>
      <name>BATT Online (engraving; scramble — CART off; arms electric hyd for NWS)</name>
      <value>ON</value>
      <condition>
        <equals>
          <property>/fdm/jsbsim/systems/grenadier/charm/battery-online</property>
          <value>1</value>
        </equals>
      </condition>
    </item>

    <item>
      <name>√ Electric hyd available (steering / brakes / aero — no APU start)</name>
      <condition>
        <equals>
          <property>/fdm/jsbsim/systems/grenadier/hyd/available</property>
          <value>1</value>
        </equals>
      </condition>
    </item>

    <item>
      <name>√ Flight Controller Power PLT (auto with BATT)</name>
      <condition>
        <equals>
          <property>/fdm/jsbsim/fcs/controller-power-plt</property>
          <value>1</value>
        </equals>
      </condition>
    </item>

    <item>
      <name>√ Aux bus live (battery)</name>
      <condition>
        <greater-than>
          <property>/fdm/jsbsim/systems/grenadier/charm/aux-bus-v</property>
          <value>200</value>
        </greater-than>
      </condition>
    </item>

    <item>
      <name>CRYO On (engraving)</name>
      <value>ON</value>
      <condition>
        <equals>
          <property>/fdm/jsbsim/systems/grenadier/charm/cryo-enable</property>
          <value>1</value>
        </equals>
      </condition>
    </item>

    <item>
      <name>√ Cryo / magnet thermal GO</name>
      <condition>
        <equals>
          <property>/fdm/jsbsim/systems/grenadier/charm/go-cryo</property>
          <value>1</value>
        </equals>
      </condition>
    </item>

    <item>
      <name>MAGNET Arm (engraving)</name>
      <value>ARMED</value>
      <condition>
        <equals>
          <property>/fdm/jsbsim/systems/grenadier/charm/magnet-arm</property>
          <value>1</value>
        </equals>
      </condition>
    </item>

    <item>
      <name>√ Magnet current ≥ 0.95</name>
      <condition>
        <equals>
          <property>/fdm/jsbsim/systems/grenadier/charm/go-magnet</property>
          <value>1</value>
        </equals>
      </condition>
    </item>

    <item>
      <name>FUEL + VACUUM Ready (engravings)</name>
      <condition>
        <equals>
          <property>/fdm/jsbsim/systems/grenadier/charm/go-fuel</property>
          <value>1</value>
        </equals>
      </condition>
    </item>

    <item>
      <name>RF On (engraving)</name>
      <value>ON</value>
      <condition>
        <equals>
          <property>/fdm/jsbsim/systems/grenadier/charm/rf-enable</property>
          <value>1</value>
        </equals>
      </condition>
    </item>

    <item>
      <name>CHARM On (REACTOR POWER engraving)</name>
      <value>ON</value>
      <condition>
        <equals>
          <property>/fdm/jsbsim/systems/grenadier/charm/light-cmd</property>
          <value>1</value>
        </equals>
      </condition>
    </item>

    <item>
      <name>DEC On (engraving)</name>
      <value>ON</value>
      <condition>
        <equals>
          <property>/fdm/jsbsim/systems/grenadier/charm/dec-online</property>
          <value>1</value>
        </equals>
      </condition>
    </item>

    <item>
      <name>√ Bus POWER (mode POWER / go-bus)</name>
      <condition>
        <and>
          <equals>
            <property>/fdm/jsbsim/systems/grenadier/charm/mode</property>
            <value>POWER</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/grenadier/charm/go-bus</property>
            <value>1</value>
          </equals>
        </and>
      </condition>
    </item>

    <item>
      <name>Detie CART if used (optional; scramble skips CART)</name>
      <value>DETIED / N/A</value>
      <condition>
        <equals>
          <property>/fdm/jsbsim/systems/grenadier/charm/cart-tied</property>
          <value>0</value>
        </equals>
      </condition>
    </item>
  </checklist>

  <checklist>
    <title>Grenadier — Steering / taxi</title>

    <item>
      <name>View — Pilot (right seat)</name>
      <value>SELECTED</value>
    </item>

    <item>
      <name>BATT Online (APU OPERATE engraving — not APU START)</name>
      <value>ON</value>
      <condition>
        <equals>
          <property>/fdm/jsbsim/systems/grenadier/charm/battery-online</property>
          <value>1</value>
        </equals>
      </condition>
    </item>

    <item>
      <name>√ Electric hyd available (replaces Shuttle APU hyd)</name>
      <condition>
        <equals>
          <property>/fdm/jsbsim/systems/grenadier/hyd/available</property>
          <value>1</value>
        </equals>
      </condition>
    </item>

    <item>
      <name>√ Flight Controller Power PLT ON</name>
      <condition>
        <equals>
          <property>/fdm/jsbsim/fcs/controller-power-plt</property>
          <value>1</value>
        </equals>
      </condition>
    </item>

    <item>
      <name>Num Lock ON</name>
      <value>ON</value>
    </item>

    <item>
      <name>External view — wing TE + vertical tail visible</name>
      <value>SELECTED</value>
    </item>

    <item>
      <name>Elevons — hold KP 2 (TE down) then KP 8 (TE up); watch both wings</name>
      <value>CHECKED</value>
    </item>

    <item>
      <name>Roll — hold KP 4 then KP 6; opposite wing motion</name>
      <value>CHECKED</value>
    </item>

    <item>
      <name>Rudder / NWS — hold KP 0 then KP Enter; rudder + nosewheel</name>
      <value>CHECKED</value>
    </item>

    <item>
      <name>KP 5 center all; return to Pilot view</name>
      <value>CHECKED</value>
    </item>

    <item>
      <name>Do not start heritage APU / hyd pump switches (blanked)</name>
      <value>N/A</value>
    </item>
  </checklist>

  <checklist>
    <title>Grenadier — Engine stage</title>

    <item>
      <name>√ Plant OK (CHARM POWER)</name>
      <condition>
        <equals>
          <property>/fdm/jsbsim/systems/grenadier/engine/plant-ok</property>
          <value>1</value>
        </equals>
      </condition>
    </item>

    <item>
      <name>√ Altimeter / recommended σ</name>
      <value>NOTED</value>
    </item>

    <item>
      <name>Select σ1 / σ2 / σ3</name>
      <value>SET</value>
    </item>

    <item>
      <name>For σ3: inlet SEALED</name>
      <condition>
        <or>
          <less-than>
            <property>/fdm/jsbsim/systems/grenadier/engine/sigma</property>
            <value>3</value>
          </less-than>
          <equals>
            <property>/fdm/jsbsim/systems/grenadier/engine/inlet-sealed</property>
            <value>1</value>
          </equals>
        </or>
      </condition>
    </item>

    <item>
      <name>√ Water remaining (σ3)</name>
      <value>NOTED</value>
    </item>

    <item>
      <name>Throttle as required</name>
      <value>SET</value>
    </item>
  </checklist>
</PropertyList>
