<?xml version="1.0"?>
<!--
  Grenadier exhaust VFX — scales with systems/grenadier/vfx/* from ops Nasal.
  Tiny thrust: small thruster flame mesh.
  Big thrust: cyan/white plasma particle plume.
-->
<PropertyList>

  <!-- Tiny / continuous core flame (mesh) -->
  <model>
    <path>Aircraft/CatskillsFusionSSTO/Models/Effects/Grenadier/grenadier_exhaust_flame.xml</path>
    <condition>
      <greater-than>
        <property>/fdm/jsbsim/systems/grenadier/vfx/show-flame</property>
        <value>0</value>
      </greater-than>
    </condition>
  </model>

  <!-- Hot plasma core (appears once past idle spit) -->
  <particlesystem>
    <type>trail</type>
    <name>grenadier_plasma_core</name>
    <texture>../orbitron_nozzle_flame.png</texture>
    <emissive>true</emissive>
    <lighting>false</lighting>
    <x-m>0.15</x-m>
    <y-m>0.0</y-m>
    <z-m>0.0</z-m>
    <roll-deg>0.0</roll-deg>
    <pitch-deg>90.0</pitch-deg>
    <heading-deg>0.0</heading-deg>
    <condition>
      <greater-than>
        <property>/fdm/jsbsim/systems/grenadier/vfx/show-plume</property>
        <value>0</value>
      </greater-than>
    </condition>
    <attach>local</attach>
    <placer>
      <type>point</type>
    </placer>
    <shooter>
      <theta-min-deg>88.0</theta-min-deg>
      <theta-max-deg>92.0</theta-max-deg>
      <phi-min-deg>-1.0</phi-min-deg>
      <phi-max-deg>1.0</phi-max-deg>
      <speed-mps>
        <property>/fdm/jsbsim/systems/grenadier/vfx/exhaust-speed-mps</property>
        <spread>15</spread>
      </speed-mps>
    </shooter>
    <counter>
      <particles-per-sec>
        <property>/fdm/jsbsim/systems/grenadier/vfx/core-rate</property>
        <spread>20</spread>
      </particles-per-sec>
    </counter>
    <align>billboard</align>
    <particle>
      <start>
        <color>
          <red><value>0.55</value></red>
          <green><value>0.95</value></green>
          <blue><value>1.0</value></blue>
          <alpha>
            <property>/fdm/jsbsim/systems/grenadier/vfx/plume-norm</property>
            <factor>0.9</factor>
            <offset>0.1</offset>
            <min>0.0</min>
            <max>1.0</max>
          </alpha>
        </color>
        <size>
          <property>/fdm/jsbsim/systems/grenadier/vfx/core-size-m</property>
          <factor>1.0</factor>
          <min>0.15</min>
          <max>4.0</max>
        </size>
      </start>
      <end>
        <color>
          <red><value>0.35</value></red>
          <green><value>0.55</value></green>
          <blue><value>1.0</value></blue>
          <alpha>
            <property>/fdm/jsbsim/systems/grenadier/vfx/plume-norm</property>
            <factor>0.15</factor>
            <min>0.0</min>
            <max>0.4</max>
          </alpha>
        </color>
        <size>
          <property>/fdm/jsbsim/systems/grenadier/vfx/core-size-m</property>
          <factor>2.8</factor>
          <min>0.4</min>
          <max>10.0</max>
        </size>
      </end>
      <life-sec>
        <value>0.35</value>
        <spread>0.12</spread>
      </life-sec>
      <mass-kg>0.02</mass-kg>
      <radius-m>0.05</radius-m>
    </particle>
    <program>
      <fluid>air</fluid>
      <gravity type="bool">false</gravity>
      <wind type="bool">true</wind>
    </program>
  </particlesystem>

  <!-- Outer plasma sheath — the big plume at high thrust -->
  <particlesystem>
    <type>trail</type>
    <name>grenadier_plasma_plume</name>
    <texture>../orbitron_nozzle_plume.png</texture>
    <emissive>true</emissive>
    <lighting>false</lighting>
    <x-m>0.4</x-m>
    <y-m>0.0</y-m>
    <z-m>0.0</z-m>
    <roll-deg>0.0</roll-deg>
    <pitch-deg>90.0</pitch-deg>
    <heading-deg>0.0</heading-deg>
    <condition>
      <greater-than>
        <property>/fdm/jsbsim/systems/grenadier/vfx/plume-norm</property>
        <value>0.18</value>
      </greater-than>
    </condition>
    <attach>local</attach>
    <placer>
      <type>point</type>
    </placer>
    <shooter>
      <theta-min-deg>86.0</theta-min-deg>
      <theta-max-deg>94.0</theta-max-deg>
      <phi-min-deg>-4.0</phi-min-deg>
      <phi-max-deg>4.0</phi-max-deg>
      <speed-mps>
        <property>/fdm/jsbsim/systems/grenadier/vfx/exhaust-speed-mps</property>
        <factor>0.75</factor>
        <spread>40</spread>
      </speed-mps>
    </shooter>
    <counter>
      <particles-per-sec>
        <property>/fdm/jsbsim/systems/grenadier/vfx/plume-rate</property>
        <spread>40</spread>
      </particles-per-sec>
    </counter>
    <align>billboard</align>
    <particle>
      <start>
        <color>
          <red><value>0.25</value></red>
          <green><value>0.75</value></green>
          <blue><value>1.0</value></blue>
          <alpha>
            <property>/fdm/jsbsim/systems/grenadier/vfx/plume-norm</property>
            <factor>0.55</factor>
            <min>0.0</min>
            <max>0.85</max>
          </alpha>
        </color>
        <size>
          <property>/fdm/jsbsim/systems/grenadier/vfx/plume-size-m</property>
          <factor>1.0</factor>
          <min>0.4</min>
          <max>8.0</max>
        </size>
      </start>
      <end>
        <color>
          <red><value>0.15</value></red>
          <green><value>0.35</value></green>
          <blue><value>0.85</value></blue>
          <alpha>
            <value>0.0</value>
          </alpha>
        </color>
        <size>
          <property>/fdm/jsbsim/systems/grenadier/vfx/plume-size-m</property>
          <factor>3.5</factor>
          <min>1.0</min>
          <max>22.0</max>
        </size>
      </end>
      <life-sec>
        <value>0.55</value>
        <spread>0.2</spread>
      </life-sec>
      <mass-kg>0.03</mass-kg>
      <radius-m>0.08</radius-m>
    </particle>
    <program>
      <fluid>air</fluid>
      <gravity type="bool">false</gravity>
      <wind type="bool">true</wind>
    </program>
  </particlesystem>

</PropertyList>
