<?xml version="1.0"?>
<!-- Tiny→large thruster flame mesh; scale driven by grenadier/vfx/flame-scale. -->
<PropertyList>
  <path>Aircraft/Generic/Effects/Thruster/thrust_flame.ac</path>
  <nopreview/>

  <animation>
    <type>scale</type>
    <property>/fdm/jsbsim/systems/grenadier/vfx/flame-scale</property>
    <x-offset>0.0</x-offset>
    <y-offset>0.0</y-offset>
    <z-offset>0.0</z-offset>
    <x-factor>1.0</x-factor>
    <y-factor>1.0</y-factor>
    <z-factor>1.0</z-factor>
  </animation>

  <effect>
    <inherits-from>Aircraft/CatskillsFusionSSTO/Models/Effects/ssme-flame1</inherits-from>
    <object-name>Bounding_box</object-name>
  </effect>
</PropertyList>
