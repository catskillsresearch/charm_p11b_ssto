<?xml version="1.0"?>
<!-- CATSKILLS-SSTO-TA-GRENADIER: rounded aft fairing + opaque petal combined-cycle nozzle. -->
<PropertyList>
  <path>Aircraft/CatskillsFusionSSTO/Models/Grenadier/grenadier_nozzle.ac</path>

  <effect>
    <inherits-from>Aircraft/CatskillsFusionSSTO/Models/Effects/shuttle-main</inherits-from>
    <object-name>grenadier-aft-fairing</object-name>
    <object-name>grenadier-aft-bulkhead</object-name>
    <object-name>grenadier-stub-can-U</object-name>
    <object-name>grenadier-stub-can-L</object-name>
    <object-name>grenadier-stub-can-R</object-name>
    <object-name>grenadier-throat-bulkhead</object-name>
    <object-name>grenadier-throat-bulkhead-face</object-name>
    <object-name>grenadier-nozzle-outer</object-name>
    <object-name>grenadier-nozzle-inner</object-name>
    <object-name>grenadier-nozzle-lip</object-name>
    <object-name>grenadier-nozzle-throat-tube</object-name>
    <object-name>grenadier-nozzle-throat-ring</object-name>
    <object-name>grenadier-nozzle-collar</object-name>
    <object-name>grenadier-nozzle-label</object-name>
  </effect>
  <effect>
    <inherits-from>Aircraft/CatskillsFusionSSTO/Models/Effects/shuttle-main</inherits-from>
    <object-name>grenadier-nozzle-petal-0</object-name>
    <object-name>grenadier-nozzle-petal-1</object-name>
    <object-name>grenadier-nozzle-petal-2</object-name>
    <object-name>grenadier-nozzle-petal-3</object-name>
    <object-name>grenadier-nozzle-petal-4</object-name>
    <object-name>grenadier-nozzle-petal-5</object-name>
    <object-name>grenadier-nozzle-petal-6</object-name>
    <object-name>grenadier-nozzle-petal-7</object-name>
    <object-name>grenadier-nozzle-petal-8</object-name>
    <object-name>grenadier-nozzle-petal-9</object-name>
    <object-name>grenadier-nozzle-petal-10</object-name>
    <object-name>grenadier-nozzle-petal-11</object-name>
    <object-name>grenadier-nozzle-petal-12</object-name>
    <object-name>grenadier-nozzle-petal-13</object-name>
    <object-name>grenadier-nozzle-petal-14</object-name>
    <object-name>grenadier-nozzle-petal-15</object-name>
    <object-name>grenadier-nozzle-petal-16</object-name>
    <object-name>grenadier-nozzle-petal-17</object-name>
    <object-name>grenadier-nozzle-petal-18</object-name>
    <object-name>grenadier-nozzle-petal-19</object-name>
  </effect>

  <model>
    <path>Aircraft/CatskillsFusionSSTO/Models/Effects/Grenadier/grenadier_exhaust.xml</path>
    <offsets>
      <x-m>16.50</x-m>
      <y-m>0.0</y-m>
      <z-m>-2.45</z-m>
      <pitch-deg>-6.0</pitch-deg>
    </offsets>
    <condition>
      <and>
        <property>/sim/model/grenadier/enabled</property>
        <greater-than>
          <property>/fdm/jsbsim/systems/grenadier/vfx/show-flame</property>
          <value>0</value>
        </greater-than>
      </and>
    </condition>
  </model>
</PropertyList>
