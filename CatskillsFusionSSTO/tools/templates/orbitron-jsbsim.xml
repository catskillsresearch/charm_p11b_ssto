            <fcs_function name="systems/orbitron_sfx/motor_generator_volume">
                <function>
                    <min>
                        <value> 1.0 </value>
                        <max>
                            <value> 0.0 </value>
                            <sum>
                                <product>
                                    <property>systems/orbitron/bleed-air-open</property>
                                    <property>systems/orbitron/pad-apu-online</property>
                                    <property>systems/orbitron/starter-engage</property>
                                    <sum>
                                        <value> 0.18 </value>
                                        <product>
                                            <property>systems/orbitron/compressor-effective</property>
                                            <value> 0.62 </value>
                                        </product>
                                    </sum>
                                </product>
                                <product>
                                    <property>systems/reactor/active</property>
                                    <sum>
                                        <value> 0.10 </value>
                                        <product>
                                            <property>systems/orbitron/compressor-effective</property>
                                            <value> 0.52 </value>
                                        </product>
                                        <product>
                                            <property>systems/orbitron/compressor-effective</property>
                                            <value> 0.28 </value>
                                            <min>
                                                <value> 1.0 </value>
                                                <product>
                                                    <property>systems/arcjet/thrust-lbf</property>
                                                    <value> 0.00014 </value>
                                                </product>
                                            </min>
                                        </product>
                                    </sum>
                                </product>
                            </sum>
                        </max>
                    </min>
                </function>
            </fcs_function>

