                                    </product>
                                </min>
                                <min>
                                    <value> 1.0 </value>
                                    <product>
                                        <property>systems/reactor/beam-current-ma</property>
                                        <value> 0.018 </value>
                                    </product>
                                </min>
                                <min>
                                    <value> 1.0 </value>
                                    <quotient>
                                        <property>systems/reactor/cathode-voltage-kv</property>
                                        <value> 600.0 </value>
                                    </quotient>
                                </min>
                            </product>
                        </max>
                    </min>
